# =====================================
# PYTHON CACHE / BUILD ARTIFACTS
# =====================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.log

# =====================================
# ENVIRONMENT VARIABLES / KEYS
# (never upload secrets to GitHub)
# =====================================
.env
*.env
.env.*
.DS_Store
Thumbs.db

# =====================================
# LOCAL VECTOR DATABASE FILES
# (NOT allowed on Streamlit Cloud)
# =====================================
vectordb/
chroma_db/
*.sqlite
*.sqlite3
*.bin
*.hnsw
*.faiss
*.pkl
*.npz

# =====================================
# INPUT TRANSCRIPT (optional to ignore)
# If you want transcript inside GitHub,
# remove the next line.
# =====================================
cleaned_transcript.txt

# =====================================
# EDITOR / IDE CONFIG FILES
# =====================================
.vscode/
.idea/

# =====================================
# DEPLOYMENT / OS GENERATED FILES
# =====================================
*.swp
*.tmp
*.bak
*.orig
*~

# =====================================
# STREAMLIT INTERNAL FILES
# =====================================
.streamlit/
